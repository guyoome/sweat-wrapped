# Create an API application at https://www.strava.com/settings/api
# "Authorization Callback Domain" must be the host of APP_URL (e.g. localhost).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Public URL of the app (no trailing slash). Used to build the OAuth redirect_uri.
APP_URL=http://localhost:3000

# Random string >= 32 chars used to encrypt the session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
